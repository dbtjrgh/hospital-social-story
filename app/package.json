{
  "name": "hospital-social-story",
  "version": "0.1.0",
  "description": "발달장애인을 위한 병원방문 지원 인터랙티브 소셜스토리",
  "author": "dbtjrgh",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node tools/dev-app.mjs",
    "dev:web": "node tools/hospital.mjs dev",
    "build": "node tools/check.mjs && yarn typecheck && node tools/hospital.mjs build",
    "preview": "node tools/hospital.mjs preview",
    "check:content": "node tools/check.mjs",
    "test:e2e": "yarn build && node tools/build-player.mjs && playwright test",
    "test:safari": "yarn build && node tools/build-player.mjs && playwright test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "icon": "node tools/make-icon.mjs",
    "new-hospital": "node tools/new-hospital.mjs",
    "build:app": "node tools/build-app.mjs",
    "build:player": "node tools/build-player.mjs",
    "app": "electron-vite build && node tools/build-player.mjs && electron-vite preview --skipBuild"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "pixi.js": "^8.22.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrweb": "2.1.7",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "7.3.7"
  }
}
